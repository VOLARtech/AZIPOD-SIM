{
  "name": "azipod-bridge",
  "version": "3.0.0",
  "description": "Twin-Azipod ship-handling simulator (PWA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:single": "vite build --mode single",
    "build:all": "npm run build && npm run build:single && cp dist-single/index.html dist/azipod-bridge-offline.html",
    "preview": "vite preview",
    "test": "tsx scripts/test.ts",
    "trials": "tsx scripts/trials.ts",
    "validate": "tsx scripts/validate.ts",
    "icons": "python3 scripts/icons.py"
  },
  "author": "VOLARtech",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/three": "^0.186.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.21.1",
    "vite-plugin-singlefile": "^2.0.3",
    "workbox-window": "^7.3.0"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "three": "^0.186.1"
  },
  "private": true
}
